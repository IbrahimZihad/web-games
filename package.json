{
  "name": "web-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:realtime": "tsx services/realtime/src/server.mts",
    "build": "npm run games:build && next build",
    "games:build": "npm run games:build:pixi && npm run games:build:three",
    "games:build:pixi": "vite build --config games/prism-pilot/vite.config.mts",
    "games:build:three": "vite build --config games/void-rally/vite.config.mts",
    "start": "next start",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/setup-local-db.mjs",
    "worker:play-counts": "tsx scripts/play-count-worker.mts",
    "k6:smoke": "k6 run scripts/k6/smoke.js",
    "k6:load": "k6 run scripts/k6/load.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/instrumentation": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "^11.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/yauzl": "^3.4.0",
    "@vercel/otel": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.10",
    "express": "^5.3.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "5.24.6",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "pm2": "^7.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pixi.js": "^8.23.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "three": "^0.187.0",
    "typescript": "^5",
    "vite": "^8.4.0"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "@graphql-tools/executor": "2.1.0",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5"
  }
}
